{
  "name": "@dam/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "clean": "rm -rf dist",
    "test": "tsx --experimental-test-coverage --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@dam/asset-processing": "workspace:*",
    "@dam/db": "workspace:*",
    "@dam/logger": "workspace:*",
    "@dam/rabbitmq": "workspace:*",
    "@dam/shared-types": "workspace:*",
    "@dam/storage": "workspace:*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  }
}
