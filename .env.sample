# Environment Variables for DAM Platform
# Copy this file to .env and adjust as necessary

# Environment
NODE_ENV=development

# Application Ports
WEB_PORT=5173
API_PORT=3000

# Database Configuration (PostgreSQL)
# Default matches the docker-compose postgres service
DATABASE_URL=postgresql://dam:dam@localhost:15432/dam?schema=public

# Message Queue (RabbitMQ)
# Default matches the docker-compose rabbitmq service
RABBITMQ_URL=amqp://dam:dam@localhost:5672

# Storage Configuration (MinIO)
# Default matches the docker-compose minio service
MINIO_ENDPOINT=localhost
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=damadmin
MINIO_SECRET_KEY=damadmin123
MINIO_BUCKET=assets

# Authentication
# Change this to a secure random string in production
JWT_SECRET=dev-super-secret-change-me

# Redis Configuration (Optional depending on usage)
REDIS_URL=redis://localhost:16379
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000
